---
import { Image } from "astro:assets";
import baselVideo from "../assets/about/fc-basel.mp4?url";
import gym from "../assets/about/gym.jpeg";
import tennis from "../assets/about/tennis.jpeg";
import monza from "../assets/about/monza.jpeg";

const moments = [
  {
    alt: "FC Basel match at St. Jakob-Park",
    label: "football",
    note: "// matchdays in basel",
    video: baselVideo,
  },
  {
    image: gym,
    alt: "Gym training area",
    label: "lifting",
    note: "// you vs you",
  },
  {
    image: tennis,
    alt: "Tennis court at night",
    label: "tennis",
    note: "// late nights in antalya",
  },
  {
    image: monza,
    alt: "Visit to the Monza circuit",
    label: "formula one",
    note: "// monza grand prix",
  },
];
---

<div class="personal-gallery">
  <p class="section-label gallery-label" data-reveal>Off the clock</p>
  <div class="moments">
    {
      moments.map(({ image, alt, label, note, video }) => (
        <figure data-reveal data-basel={video ? "" : undefined}>
          <div class="media">
            {video ? (
              <button
                class="video-toggle"
                type="button"
                aria-label={`Play ${alt}`}
              >
                <video
                  src={video}
                  preload="metadata"
                  muted
                  loop
                  playsinline
                  aria-hidden="true"
                />
              </button>
            ) : (
              image && (
                <Image
                  src={image}
                  alt={alt}
                  widths={[400, 640, 880, 1200]}
                  sizes="(min-width: 1240px) 420px, (min-width: 48rem) 34vw, 94vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
              )
            )}
          </div>
          <figcaption>
            <span>{label}</span>
            {note && <span class="note">{note}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script>
  const basel = document.querySelector<HTMLElement>("[data-basel]");
  const video = basel?.querySelector("video");
  const toggle = basel?.querySelector("button");

  if (basel && video && toggle) {
    let inView = !("IntersectionObserver" in window);
    // Preserve an explicit pause when the item leaves and re-enters the viewport.
    let manuallyPaused = false;

    const updateLabel = () => {
      toggle.setAttribute(
        "aria-label",
        `${video.paused ? "Play" : "Pause"} FC Basel match at St. Jakob-Park`,
      );
    };

    const syncPlayback = () => {
      if (!inView || document.hidden || manuallyPaused) {
        video.pause();
      } else if (video.paused) {
        video.muted = true;
        // Start on viewport entry on both desktop and touch devices. Requesting
        // playback here avoids running the video while it is offscreen.
        void video.play().catch(updateLabel);
      }
    };

    toggle.addEventListener("click", () => {
      manuallyPaused = !video.paused;
      syncPlayback();
    });

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        syncPlayback();
      });
      observer.observe(video);
    }

    video.addEventListener("play", updateLabel);
    video.addEventListener("pause", updateLabel);
    document.addEventListener("visibilitychange", syncPlayback);
    window.addEventListener("pagehide", () => video.pause());
    window.addEventListener("pageshow", syncPlayback);
    syncPlayback();
  }
</script>

<style>
  .personal-gallery {
    min-width: 0;
    width: 100%;
    justify-self: center;
    margin-top: var(--space-7);
  }

  .gallery-label {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .moments {
    display: grid;
    gap: var(--space-7) var(--space-6);
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  .media {
    position: relative;
    aspect-ratio: 16 / 9;
  }

  .media img,
  .media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .video-toggle {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 48rem) {
    .personal-gallery {
      grid-column: 1 / -1;
      width: calc(75% - var(--space-6) / 2);
    }

    .moments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .media {
      transition: transform var(--reveal-duration) ease-out;
    }

    figure:hover .media {
      transform: scale(1.01);
    }
  }
</style>
