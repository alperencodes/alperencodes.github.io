---
import type { Work } from "../data/work";
import ExternalLink from "./ExternalLink.astro";

interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
---

<li data-reveal>
  <article>
    <span class="number" aria-hidden="true"
      >{String(index + 1).padStart(2, "0")}</span
    >
    <div class="identity">
      <h3>{work.title}</h3>
      <p class="context">{work.context}</p>
    </div>
    <div class="details">
      <p class="description">{work.description}</p>
      <p class="technologies">{work.technologies.join(" · ")}</p>
      {
        work.href && (
          <ExternalLink
            href={work.href}
            label={work.linkLabel ?? "View source"}
            accessibleLabel={`${work.linkLabel ?? "View source"} — ${work.title}`}
          />
        )
      }
    </div>
  </article>
</li>

<style>
  li {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  article {
    display: grid;
    grid-template-columns: var(--space-6) minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .number {
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
  h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  .context {
    margin-top: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
  .details {
    grid-column: 2;
  }
  .description {
    max-width: 52ch;
  }
  .technologies {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .details :global(.external-link) {
    margin-top: var(--space-3);
  }

  @media (min-width: 48rem) {
    article {
      grid-template-columns: var(--space-6) minmax(0, 4fr) minmax(0, 6fr);
      gap: var(--space-6);
      padding-block: var(--space-7);
    }
    .details {
      grid-column: 3;
    }
  }
  @media (min-width: 60rem) {
    article {
      grid-template-columns: 1fr 4fr 7fr;
    }
  }
</style>
