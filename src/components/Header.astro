---
import { existsSync } from "node:fs";

// Adding the real document enables navigation on the next build, with no broken placeholder.
const hasCv = existsSync(new URL("../../public/cv.pdf", import.meta.url));
---

<header class="container">
  <a class="wordmark" href="/" aria-label="alperen. — Home">alperen.</a>
  <nav aria-label="Main navigation">
    <a class="quiet-link" href="/#work">Work</a>
    <a class="quiet-link" href="/#about">About</a>
    {
      hasCv && (
        <a class="quiet-link" href="/cv.pdf">
          CV <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .wordmark {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    header {
      padding-block: var(--space-6);
    }
    nav {
      gap: var(--space-6);
    }
  }
</style>
